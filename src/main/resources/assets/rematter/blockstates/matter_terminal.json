{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "active": "false"
      },
      "apply": {
        "model": "rematter:block/matter_terminal"
      }
    },
    {
      "when": {
        "facing": "north",
        "active": "true"
      },
      "apply": {
        "model": "rematter:block/matter_terminal_active"
      }
    },
    {
      "when": {
        "facing": "east",
        "active": "false"
      },
      "apply": {
        "model": "rematter:block/matter_terminal",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "active": "true"
      },
      "apply": {
        "model": "rematter:block/matter_terminal_active",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "active": "false"
      },
      "apply": {
        "model": "rematter:block/matter_terminal",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "active": "true"
      },
      "apply": {
        "model": "rematter:block/matter_terminal_active",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "active": "false"
      },
      "apply": {
        "model": "rematter:block/matter_terminal",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "active": "true"
      },
      "apply": {
        "model": "rematter:block/matter_terminal_active",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "back_cable": "true"
      },
      "apply": {
        "model": "rematter:block/machine_socket_back_machine_mint"
      }
    },
    {
      "when": {
        "facing": "east",
        "back_cable": "true"
      },
      "apply": {
        "model": "rematter:block/machine_socket_back_machine_mint",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "back_cable": "true"
      },
      "apply": {
        "model": "rematter:block/machine_socket_back_machine_mint",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "back_cable": "true"
      },
      "apply": {
        "model": "rematter:block/machine_socket_back_machine_mint",
        "y": 270
      }
    }
  ]
}
