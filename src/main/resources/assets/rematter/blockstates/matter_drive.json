{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "rematter:block/matter_drive"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "rematter:block/matter_drive",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "rematter:block/matter_drive",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "rematter:block/matter_drive",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "active": "false"
      },
      "apply": {
        "model": "rematter:block/matter_drive_activity_off"
      }
    },
    {
      "when": {
        "facing": "east",
        "active": "false"
      },
      "apply": {
        "model": "rematter:block/matter_drive_activity_off",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "active": "false"
      },
      "apply": {
        "model": "rematter:block/matter_drive_activity_off",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "active": "false"
      },
      "apply": {
        "model": "rematter:block/matter_drive_activity_off",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "active": "true"
      },
      "apply": {
        "model": "rematter:block/matter_drive_activity_on"
      }
    },
    {
      "when": {
        "facing": "east",
        "active": "true"
      },
      "apply": {
        "model": "rematter:block/matter_drive_activity_on",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "active": "true"
      },
      "apply": {
        "model": "rematter:block/matter_drive_activity_on",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "active": "true"
      },
      "apply": {
        "model": "rematter:block/matter_drive_activity_on",
        "y": 270
      }
    }
  ]
}
