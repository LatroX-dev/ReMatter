{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "rematter:wrench_mode",
    "cases": [
      {
        "when": "ports",
        "model": {
          "type": "minecraft:model",
          "model": "rematter:item/matter_wrench"
        }
      },
      {
        "when": "rotate",
        "model": {
          "type": "minecraft:model",
          "model": "rematter:item/matter_wrench_rotate"
        }
      },
      {
        "when": "dismantle",
        "model": {
          "type": "minecraft:model",
          "model": "rematter:item/matter_wrench_dismantle"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "rematter:item/matter_wrench"
    }
  }
}
