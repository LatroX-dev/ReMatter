{
  "model": {
    "type": "minecraft:select",
    "property": "rematter:cell_status",
    "cases": [
      {
        "when": "empty",
        "model": {
          "type": "minecraft:model",
          "model": "rematter:item/matter_cell_1m_empty"
        }
      },
      {
        "when": "stored",
        "model": {
          "type": "minecraft:model",
          "model": "rematter:item/matter_cell_1m_stored"
        }
      },
      {
        "when": "full",
        "model": {
          "type": "minecraft:model",
          "model": "rematter:item/matter_cell_1m_full"
        }
      },
      {
        "when": "locked",
        "model": {
          "type": "minecraft:model",
          "model": "rematter:item/matter_cell_1m_locked"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "rematter:item/matter_cell_1m"
    }
  }
}
