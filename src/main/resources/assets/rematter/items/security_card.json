{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "rematter:security_card_mode",
    "cases": [
      {
        "when": "public",
        "model": {
          "type": "minecraft:model",
          "model": "rematter:item/security_card"
        }
      },
      {
        "when": "trusted",
        "model": {
          "type": "minecraft:model",
          "model": "rematter:item/security_card_trusted"
        }
      },
      {
        "when": "private",
        "model": {
          "type": "minecraft:model",
          "model": "rematter:item/security_card_private"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "rematter:item/security_card"
    }
  }
}
